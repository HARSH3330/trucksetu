{
  "name": "transivox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "e2e": "playwright test --project=chromium",
    "e2e:kyc": "playwright test --project=chromium",
    "e2e:kyc:cross-browser": "node e2e/run-playwright.mjs cross-browser",
    "e2e:kyc:aws": "node e2e/run-playwright.mjs aws",
    "e2e:kyc:report": "playwright show-report playwright-report"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "8.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "latest"
  }
}
