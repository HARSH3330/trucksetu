# ──────────────────────────────────────────────
# TruckSetu Backend — Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_NAME=TruckSetu
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql+psycopg://trucksetu:password@localhost:5432/trucksetu_db
# Neon deployments should use the pooled URL above and the direct URL here.
MIGRATION_DATABASE_URL=

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AWS S3 ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# ── Razorpay ─────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── MSG91 (SMS) ──────────────────────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── WATI (WhatsApp) ──────────────────────────
WATI_API_KEY=
WATI_BASE_URL=https://live-server-XXXXX.wati.io

# ── AI ───────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── Business Rules ───────────────────────────
PLATFORM_COMMISSION_PERCENT=8.0
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3

# ── Controlled pilot flags ───────────────────
ENABLE_SHARED_CAPACITY=true
ENABLE_IMMEDIATE_BOOKING=true
ENABLE_LIVE_GPS=false
ENABLE_AUTOMATED_PAYOUTS=false
ENABLE_AUTOMATED_KYC=false
ENABLE_INTERSTATE=false
ENABLE_PROMOTIONS=false
ENABLE_HAZARDOUS_CARGO=false
PILOT_ORIGIN_CITIES=Delhi
PILOT_DESTINATION_CITIES=Delhi,Gurugram,Noida

# ── Celery ───────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Sentry (optional) ────────────────────────
SENTRY_DSN=

# ── First Admin Seed ─────────────────────────
FIRST_SUPERADMIN_EMAIL=admin@trucksetu.in
FIRST_SUPERADMIN_PASSWORD=Admin@123
