# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Local Playwright KYC tests only. Never point this at an application database.
E2E_DATABASE_URL=postgresql://transivox_e2e_user:replace-me@127.0.0.1:5432/transivox_e2e
E2E_ALLOWED_DATABASE_HOSTS=127.0.0.1,localhost
E2E_WEB_URL=http://127.0.0.1:5173
E2E_API_URL=http://127.0.0.1:8000/api/v1
E2E_PYTHON=python
E2E_CONTROL_TOKEN=replace-with-a-local-test-token-at-least-16-characters
E2E_PROVIDER_EMAIL=provider.e2e@example.com
E2E_PROVIDER_PASSWORD=replace-with-a-dedicated-test-password
E2E_ADMIN_EMAIL=admin.e2e@example.com
E2E_ADMIN_PASSWORD=replace-with-a-dedicated-test-admin-password
# Real AWS runs are explicit and non-resetting. Leave false for ordinary tests.
E2E_REAL_AWS=false

# API — placeholders only; replace for each environment
APP_NAME=TransivoX
APP_VERSION=1.0.0
# Optional API release metadata: valid Git SHA only; otherwise /version says unknown.
BUILD_SHA=unknown
# Vercel system source metadata, when exposed to the API runtime; preferred over BUILD_SHA.
VERCEL_GIT_COMMIT_SHA=
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173
# API: finite HttpOnly browser refresh cookie. Production requires HTTPS.
# Cross-site frontend/API: none (third-party-cookie restrictions may block it).
# Prefer same-site www.transivox.in + api.transivox.in, then use lax.
AUTH_COOKIE_SAMESITE=none
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=120
DATABASE_URL=postgresql+psycopg://trucksetu:change-me@postgres:5432/trucksetu
# Neon: pooled URL for runtime above; direct URL below for Alembic migrations.
MIGRATION_DATABASE_URL=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=false
LOGIN_RATE_LIMIT=10
SIGNUP_RATE_LIMIT=5
VERIFICATION_RATE_LIMIT=10
REFRESH_RATE_LIMIT=30
OTP_RATE_LIMIT=5
PRICING_RATE_LIMIT=20
AI_RATE_LIMIT=20
SCHEDULE_MIN_LEAD_MINUTES=30
NOW_PICKUP_LEAD_MINUTES=15
NOW_PICKUP_WINDOW_MINUTES=90
NOW_DELIVERY_WINDOW_HOURS=24
SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=transivox-api
JWT_AUDIENCE=transivox-web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
ADMIN_BOOTSTRAP_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
MSG91_AUTH_KEY=
MSG91_WIDGET_ENABLED=false
# Public widget-only configuration for Vite; NEVER put account Authkey here.
VITE_MSG91_WIDGET_ID=
VITE_MSG91_WIDGET_TOKEN_AUTH=
MSG91_TEMPLATE_ID=
MSG91_OTP_VARIABLE=OTP
WATI_API_KEY=
WATI_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
# API-only canonical frontend origin for account email links; never derive from request Host.
PUBLIC_FRONTEND_URL=
ACCOUNT_EMAIL_COOLDOWN_SECONDS=60
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Controlled Delhi/NCR pilot flags
ENABLE_SHARED_CAPACITY=true
ENABLE_IMMEDIATE_BOOKING=true
ENABLE_LIVE_GPS=false
ENABLE_AUTOMATED_PAYOUTS=false
ENABLE_AUTOMATED_KYC=false
ENABLE_INTERSTATE=false
ENABLE_PROMOTIONS=false
ENABLE_HAZARDOUS_CARGO=false
PILOT_ORIGIN_CITIES=Delhi
PILOT_DESTINATION_CITIES=Delhi,Gurugram,Noida

# Customer-led marketplace: real checkout deliberately disabled.
ENABLE_CUSTOMER_DEMAND_MARKETPLACE=true
ENABLE_LEGACY_PROVIDER_MARKETPLACE=false
ENABLE_PROVIDER_FIRST_PUBLICATION=false
ENABLE_TRANSPORT_PAYMENT_COLLECTION=false
ENABLE_REAL_CONNECTION_CHECKOUT=false
CONNECTION_FEE_AMOUNT=1000.00
CONNECTION_FEE_CURRENCY=INR
# Versioned JSON policies required; see customer-demand marketplace specification.
# Never copy test_only policies into production.
DEMAND_MARKETPLACE_POLICY=
CONNECTION_FEE_POLICY=
# Frontend primary experience; preserve legacy code for explicit local regression profile.
VITE_LEGACY_PROVIDER_MARKETPLACE=false

# Private scanner provider: no browser-authoritative results or fake GuardDuty tags.
KYC_SCAN_PROVIDER=guardduty
KYC_SCAN_RESULTS_BUCKET=
KYC_SCAN_MAX_DEFINITION_AGE_HOURS=48
# Explicit approved customer policy required; no universal document list assumed.
CUSTOMER_KYC_REQUIRED_DOCUMENTS=
CUSTOMER_KYC_POLICY_VERSION=
CUSTOMER_KYC_TEST_SIMULATION=false

# Proposed 20% tax is NOT a confirmed applicable rate.
CONNECTION_FEE_TAX_RATE=0.20
CONNECTION_FEE_TAX_CONFIRMED=false
# Only APP_ENV=test may use a hypothetical positive waiver-tax amount.
CONNECTION_FEE_WAIVER_TEST_TAX_AMOUNT=

# Explicit REAL Razorpay Test Mode on dedicated loopback database only; never live.
ENABLE_RAZORPAY_SANDBOX=false

# Approved customer consent shown before collection; unset remains fail-closed.
CUSTOMER_KYC_CONSENT_TEXT=

# Browser-only restricted Google key; never place server credentials here.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Optional local Advanced Marker map ID; DEMO_MAP_ID is used only for local development.
VITE_GOOGLE_MAPS_MAP_ID=
