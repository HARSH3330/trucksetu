# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# API — placeholders only; replace for each environment
APP_NAME=TransivoX
APP_VERSION=1.0.0
BUILD_SHA=local
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=120
DATABASE_URL=postgresql+psycopg://trucksetu:change-me@postgres:5432/trucksetu
# Neon: pooled URL for runtime above; direct URL below for Alembic migrations.
MIGRATION_DATABASE_URL=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=false
LOGIN_RATE_LIMIT=10
SIGNUP_RATE_LIMIT=5
VERIFICATION_RATE_LIMIT=10
REFRESH_RATE_LIMIT=30
OTP_RATE_LIMIT=5
PRICING_RATE_LIMIT=20
AI_RATE_LIMIT=20
SCHEDULE_MIN_LEAD_MINUTES=30
NOW_PICKUP_LEAD_MINUTES=15
NOW_PICKUP_WINDOW_MINUTES=90
NOW_DELIVERY_WINDOW_HOURS=24
SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=transivox-api
JWT_AUDIENCE=transivox-web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
MSG91_AUTH_KEY=
WATI_API_KEY=
WATI_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Controlled Delhi/NCR pilot flags
ENABLE_SHARED_CAPACITY=true
ENABLE_IMMEDIATE_BOOKING=true
ENABLE_LIVE_GPS=false
ENABLE_AUTOMATED_PAYOUTS=false
ENABLE_AUTOMATED_KYC=false
ENABLE_INTERSTATE=false
ENABLE_PROMOTIONS=false
ENABLE_HAZARDOUS_CARGO=false
PILOT_ORIGIN_CITIES=Delhi
PILOT_DESTINATION_CITIES=Delhi,Gurugram,Noida
