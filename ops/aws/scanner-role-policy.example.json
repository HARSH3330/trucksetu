{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["events:PutRule", "events:DeleteRule", "events:PutTargets", "events:RemoveTargets"],
      "Resource": "arn:aws:events:ap-south-1:<AWS_ACCOUNT_ID>:rule/DO-NOT-DELETE-AmazonGuardDutyMalwareProtectionS3*",
      "Condition": {"StringLike": {"events:ManagedBy": "malware-protection-plan.guardduty.amazonaws.com"}}
    },
    {
      "Effect": "Allow",
      "Action": ["events:DescribeRule", "events:ListTargetsByRule"],
      "Resource": "arn:aws:events:ap-south-1:<AWS_ACCOUNT_ID>:rule/DO-NOT-DELETE-AmazonGuardDutyMalwareProtectionS3*"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectTagging", "s3:GetObjectVersionTagging", "s3:PutObjectTagging", "s3:PutObjectVersionTagging"],
      "Resource": "arn:aws:s3:::transivox-kyc-harsh3330/kyc/*"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketNotification", "s3:PutBucketNotification"],
      "Resource": "arn:aws:s3:::transivox-kyc-harsh3330"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::transivox-kyc-harsh3330/malware-protection-resource-validation-object"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::transivox-kyc-harsh3330"
    }
  ]
}
